{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caddie",
  "version": "0.1.0",
  "identifier": "dev.caddie.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --dir ../.. --filter @companion/pwa build && pnpm build",
      "wait": true
    },
    "beforeBuildCommand": "pnpm --dir ../.. --filter @companion/pwa build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caddie",
        "width": 380,
        "height": 620,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "caddie",
      "iconPath": "icons/tray-template.png",
      "iconAsTemplate": true,
      "tooltip": "Caddie"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../pwa/dist": "pwa"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Oh-Damn/caddie/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2OTdEQjY5OURGRTNBOTMKUldTVE92NmRhZHVYTm5SaUtDYnAwRU5aNGpsa29oZGdRelBETmNWS1I1UlNWQVZrL3g1NGdKU28K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
