<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri signs with the hardened runtime, which blocks Apple Events unless
       the sending process carries this. Automation drives Music, Spotify,
       System Events and the browsers. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
